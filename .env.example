# Copy this file to .env and fill in your values.
# The .env file is loaded automatically when you run the API server locally.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Example (local Postgres): postgresql://postgres:password@localhost:5432/rfid_dashboard
# Example (Neon, Supabase, etc.): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/rfid_dashboard

# ─── Session ──────────────────────────────────────────────────────────────────
# Random secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-secret-string

# ─── Local admin credentials ──────────────────────────────────────────────────
# Username and password for the dashboard login form (local mode).
# Defaults to admin / admin if not set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ─── Server ports (optional — these are the defaults) ─────────────────────────
# API server port
PORT=8080
# Frontend dev server port
# VITE_PORT=3000
